# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase Configuration (Agent Platform Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Xendit Payment Gateway (server-side secrets) ─────────────────────────────
# Set these in Supabase Dashboard → Settings → Edge Functions → Secrets
# These are NOT frontend env vars — never prefix with VITE_
#
# XENDIT_SECRET_KEY=xnd_production_...
#   From: Xendit Dashboard → Settings → API Keys
#
# XENDIT_WEBHOOK_TOKEN=...
#   From: Xendit Dashboard → Settings → Webhooks → Callback token
#
# APP_URL=https://surepath.app
#   Production URL used for payment success/failure redirects
#
# Webhook URL to register in Xendit Dashboard → Settings → Webhooks:
#   https://your-project-id.supabase.co/functions/v1/xendit-webhook
#
# Edge Functions (already deployed & active):
#   POST https://your-project-id.supabase.co/functions/v1/create-xendit-invoice
#   POST https://your-project-id.supabase.co/functions/v1/xendit-webhook
