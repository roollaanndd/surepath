    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vercel/analytics": "^2.0.1",
    "cors": "^2.8.6",
    "dexie": "^4.2.1",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.39.0",
