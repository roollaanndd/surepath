# ─── SurePath — Development-mode defaults (Vite) ──────────────────────────────
# Loaded automatically by Vite when running in development mode (`npm run dev`,
# `vite` with no --mode flag). Committed to git — placeholder values only,
# NEVER real secrets. Only VITE_* vars are exposed to the browser bundle.
#
# For your own local secrets (a real dev/staging Supabase project, a personal
# Sentry DSN, etc.), create `.env.development.local` instead — it's already
# covered by the `*.local` pattern in .gitignore and always takes precedence
# over this file, so it's never committed.

# Supabase (required — point this at a dev/staging project, never production)
VITE_SUPABASE_URL=https://your-dev-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-supabase-anon-key

# Analytics (optional — usually left blank in development)
VITE_GA4_ID=
VITE_GSC_VERIFY=

# Error monitoring (optional — usually left blank in development to avoid
# polluting production error tracking with local noise)
VITE_SENTRY_DSN=

# Admin CMS key (optional, dev-only convenience — see .env.example)
VITE_ADMIN_KEY=
