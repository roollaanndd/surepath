# SurePath — environment variable template
# Copy to .env.local and fill in your real values. NEVER commit .env.local.

# Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Xendit (payment gateway) — set in Supabase Vault, not here
# XENDIT_SECRET_KEY=xnd_production_...

# Admin gate (set in Vercel Dashboard, never hardcode)
VITE_ADMIN_KEY=your-admin-key
