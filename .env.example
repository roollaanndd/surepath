# ─── Xendit Payment Gateway (server-side secrets) ─────────────────────────────
# Set these in Supabase Dashboard → Settings → Edge Functions → Secrets
# These are NOT frontend env vars — never prefix with VITE_
#
# XENDIT_SECRET_KEY=xnd_production_...
#   From: Xendit Dashboard → Settings → API Keys
#
# XENDIT_WEBHOOK_TOKEN=...
#   From: Xendit Dashboard → Settings → Webhooks → Callback token
#
# APP_URL=https://surepath.app
#   Production URL used for payment success/failure redirects
#
