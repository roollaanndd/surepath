{
  "name": "surepath---neural-insurtech",
  "private": true,
  "version": "1.40.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build-server/server.cjs && node scripts/check-dist-clean.mjs && node scripts/check-pwa-build.mjs",
    "start": "node build-server/server.cjs",
    "preview": "vite preview",
    "lint": "node scripts/check-edge-functions.mjs && tsc --noEmit && eslint . && vitest run",
    "lint:fix": "eslint . --fix",
    "lint:ts": "tsc --noEmit",
    "lint:es": "eslint .",
    "test": "vitest run && playwright test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "check:functions": "node scripts/check-edge-functions.mjs",
    "check:dist": "node scripts/check-dist-clean.mjs",
    "check:android": "node scripts/sync-android-version.mjs --check",
    "sync:android": "node scripts/sync-android-version.mjs",
    "build:android": "node scripts/sync-android-version.mjs && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.3",
    "@capacitor/core": "^8.4.3",
    "@sentry/react": "^10.63.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "cors": "^2.8.6",
    "dexie": "^4.2.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.39.0",
    "openai": "^6.39.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "tsx": "^4.22.3"
  },
  "overrides": {
    "nanoid": "^3.3.16",
    "dompurify": "^3.4.17",
    "@xmldom/xmldom": "^0.8.13",
    "picomatch": "^4.0.4",
    "brace-expansion": "^2.0.3",
    "fast-uri": "^3.1.1",
    "body-parser": "^2.3.0",
    "serialize-javascript": "^7.0.3",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.49.2",
    "ts-morph": "^28.0.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
