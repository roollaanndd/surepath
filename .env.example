# ─── SurePath Environment Variables ───────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# Only VITE_* vars are exposed to the browser — never put secrets here.

# Supabase (required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics (optional)
VITE_GA4_ID=              # Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GSC_VERIFY=          # Google Search Console verification token

# Error monitoring (optional)
VITE_SENTRY_DSN=          # Sentry DSN for error tracking

# ─── Server-side secrets (set in Supabase Dashboard → Edge Functions → Secrets) ──
# These are NOT prefixed with VITE_ — they live only in Supabase.
#
# SUPABASE_SERVICE_ROLE_KEY=    # Service role key (bypasses RLS)
# SUPABASE_ANON_KEY=            # Anon key (for auth.getUser() verification)
# SUPABASE_DB_URL=              # Postgres connection string (for direct SQL)
#
# XENDIT_SECRET_KEY=            # Xendit production secret key
# XENDIT_WEBHOOK_TOKEN=         # Xendit webhook verification token
#
# RESEND_API_KEY=               # Resend email API key
#
# TELEGRAM_BOT_TOKEN=           # Telegram bot token for admin alerts
# TELEGRAM_ADMIN_CHAT_ID=       # Telegram chat ID for admin notifications
#
# CRON_SECRET=                  # Secret for insurer-reminder-cron auth
#
# ─── Edge Functions (deployed & active) ──────────────────────────────────────
#   POST /functions/v1/data-gateway           — main API (70+ actions)
#   POST /functions/v1/create-xendit-invoice  — payment invoice creation
#   POST /functions/v1/xendit-webhook         — payment webhook handler
#   POST /functions/v1/xendit-disburse        — withdrawal disbursement
#   POST /functions/v1/send-insurer-email     — insurer review email
#   POST /functions/v1/insurer-reminder-cron  — scheduled reminders (every 4h)
#   POST /functions/v1/stnk-ocr               — STNK OCR via GPT-4o-mini
#   POST /functions/v1/ai-proxy               — AI chat proxy
#   POST /functions/v1/send-otp               — OTP SMS
#   POST /functions/v1/verify-otp             — OTP verification
#   POST /functions/v1/send-whatsapp          — WhatsApp message
#   POST /functions/v1/notify-admin           — admin push notification
#   POST /functions/v1/push-notify            — FCM push (stub)
#   POST /functions/v1/submit-policy-insurer  — push order to insurer API
#   POST /functions/v1/ocr-scan               — vehicle damage OCR
#   POST /functions/v1/ai-policy-review       — AI policy review
#   POST /functions/v1/ai-finance-review      — AI finance review
#   POST /functions/v1/signup-member          — member signup
#   POST /functions/v1/generate-daily-renungan — daily content
#   POST /functions/v1/backup-daily           — daily DB backup
#   POST /functions/v1/daily-report           — daily report email
